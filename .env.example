# ==============================================================
# SafeMind Distributed - Variáveis de Ambiente Opcionais
# NOTA: Nenhuma variável é obrigatória. O sistema possui fallbacks
# automáticos que funcionam de primeira tanto localmente quanto no Render.
# ==============================================================

# Porta pública do API Gateway (No Render, esta porta é injetada automaticamente)
PORT=3000

# Portas internas dos Microsserviços
AVALIACOES_PORT=3001
CADASTROS_PORT=3002

# URLs de Comunicação Síncrona Interna
SERVICO_AVALIACOES_URL=http://localhost:3001
SERVICO_CADASTROS_URL=http://localhost:3002

# Caminho dos Bancos de Dados SQLite (Opcional - padrão: ./data/cadastros.db e ./data/avaliacoes.db)
CADASTROS_DB_PATH=./data/cadastros.db
AVALIACOES_DB_PATH=./data/avaliacoes.db

